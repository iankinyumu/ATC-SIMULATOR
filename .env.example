# OpenAI cloud key for Whisper transcription and GPT-6 Luna interpretation.
# Copy to .env and add your own key. Never commit .env.
OPENAI_API_KEY=

# GPT-6 Luna conversation and command-interpretation model.
OPENAI_CHAT_MODEL=gpt-6-luna

# Cloud-first radio speech. If ElevenLabs is unavailable, Piper is used when installed.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_PROVIDER=elevenlabs

# Set VOICE_PROVIDER=piper to always use the offline fallback.
# Optional overrides. With these blank, the server selects up to 10 English
# premade voices from the account and assigns a separate controller voice.
ELEVENLABS_PILOT_VOICE_IDS=
ELEVENLABS_CONTROLLER_VOICE_ID=
