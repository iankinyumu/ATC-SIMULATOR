{
  "name": "egll-atc-sim",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/sim-core --noEmit && tsc -p packages/egll-data --noEmit && tsc -p packages/display --noEmit",
    "demo": "tsx packages/sim-core/scripts/demo.ts",
    "data:fetch": "tsx packages/egll-data/scripts/fetch-egll.ts",
    "data:build": "tsx packages/egll-data/scripts/build-egll.ts",
    "display": "npm run dev -w @atc/display",
    "piper:fetch": "tsx packages/display/server/fetchVoices.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
